{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vibenet.ai/protocol/profiles/adapter-profile/0.1/schema.json",
  "title": "VIBEnet Adapter Profile 0.1",
  "description": "Adjacent profile: ratified rules that may turn a foreign source event into a Signal Contract v1 object. This schema does not extend the flat event.",
  "$defs": {
    "when_clause": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["op", "field", "value"],
          "properties": {
            "op": { "const": "eq" },
            "field": { "type": "string", "minLength": 1 },
            "value": {}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["op", "field", "value"],
          "properties": {
            "op": { "enum": ["gte", "lt"] },
            "field": { "type": "string", "minLength": 1 },
            "value": { "type": "number" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["op", "field"],
          "properties": {
            "op": { "const": "truthy" },
            "field": { "type": "string", "minLength": 1 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["op", "clauses"],
          "properties": {
            "op": { "const": "and" },
            "clauses": {
              "type": "array",
              "minItems": 1,
              "items": { "$ref": "#/$defs/when_clause" }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["op", "min_retry", "max_confidence"],
          "properties": {
            "op": { "const": "retry_while_confidence_falling" },
            "min_retry": { "type": "integer", "minimum": 1 },
            "max_confidence": { "type": "number", "minimum": 0, "maximum": 1 }
          }
        }
      ]
    },
    "emit_spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["channel", "event"],
      "properties": {
        "channel": {
          "enum": [
            "nominal",
            "advisory",
            "warning",
            "critical",
            "recovery",
            "opportunity",
            "handoff"
          ]
        },
        "event": { "type": "string", "minLength": 1 },
        "valence": { "type": "number", "minimum": 0, "maximum": 1 },
        "energy": { "type": "number", "minimum": 0, "maximum": 1 },
        "tension": { "type": "number", "minimum": 0, "maximum": 1 },
        "intensity": { "type": "number", "minimum": 0, "maximum": 1 },
        "pulse": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "adapter_rule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "status", "when", "emit"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "label": { "type": "string", "minLength": 1 },
        "status": { "enum": ["proposed", "accepted", "rejected"] },
        "when": { "$ref": "#/$defs/when_clause" },
        "emit": { "$ref": "#/$defs/emit_spec" },
        "notes": { "type": "string" }
      }
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "profile_id",
    "version",
    "label",
    "source_schema_fingerprint",
    "rules",
    "ignored_classes",
    "protected_fields",
    "proposal_source"
  ],
  "properties": {
    "schema_version": { "const": "vibenet.adapter-profile/0.1" },
    "profile_id": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "label": { "type": "string", "minLength": 1 },
    "source_schema_fingerprint": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "rules": {
      "type": "array",
      "items": { "$ref": "#/$defs/adapter_rule" }
    },
    "ignored_classes": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "protected_fields": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "proposal_source": { "enum": ["human", "browser_assist", "imported"] }
  }
}
