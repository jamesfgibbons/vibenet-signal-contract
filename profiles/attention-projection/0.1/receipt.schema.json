{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vibenet.ai/protocol/profiles/attention-projection/0.1/receipt.schema.json",
  "title": "VIBEnet Attention Receipt 0.1",
  "description": "Audit record of one attention mix. Does not rewrite Signal Contract events.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "receipt_id",
    "mode",
    "projection_id",
    "policy_version",
    "foreground_signal_ids",
    "ambient_group_ids",
    "suppressed_event_digest",
    "suppressed_count",
    "unobserved_entities",
    "selection_summary",
    "critical_bypass",
    "audio_muted",
    "reduced_motion",
    "generated_at"
  ],
  "properties": {
    "schema_version": { "const": "vibenet.attention-receipt/0.1" },
    "receipt_id": { "type": "string", "minLength": 1 },
    "mode": { "const": "browser_local" },
    "projection_id": { "type": "string", "minLength": 1 },
    "policy_version": { "type": "string", "minLength": 1 },
    "foreground_signal_ids": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "ambient_group_ids": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "suppressed_event_digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "suppressed_count": { "type": "integer", "minimum": 0 },
    "unobserved_entities": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "selection_summary": { "type": "string", "minLength": 1 },
    "critical_bypass": { "type": "boolean" },
    "audio_muted": { "type": "boolean" },
    "reduced_motion": { "type": "boolean" },
    "generated_at": { "type": "string", "format": "date-time" }
  }
}
