{
  "profile": "vibenet.mcp-source/0.1",
  "signal_contract_version": "1.0",
  "mcp_spec_version": "2026-07-28",
  "canonical_question": "When does an MCP protocol event become a VIBEnet awareness event?",
  "adjacent": true,
  "adds_required_sc_fields": false,
  "emit_policy": "accepted_rules_only",
  "match_policy": "first_accepted_when_wins",
  "unmapped_policy": "silent_reject",
  "unknown_method_policy": "ignore",
  "source_loss_state": "unobserved",
  "listening_receipt": "vibenet.mcp-source-receipt/0.1",
  "protected_fields": [
    "prompt",
    "messages",
    "arguments",
    "result",
    "content",
    "token",
    "path",
    "email",
    "oauth_sub",
    "account_id",
    "customer_id"
  ],
  "lifecycle_states": [
    "unobserved",
    "idle",
    "running",
    "needs_input",
    "complete",
    "error"
  ],
  "precedence": [
    "error",
    "needs_input",
    "running",
    "complete",
    "idle"
  ],
  "mappings": [
    {
      "id": "rule-task-running",
      "status": "accepted",
      "when": { "mcp_condition": "task_active" },
      "emit": "agent.running"
    },
    {
      "id": "rule-input-required",
      "status": "accepted",
      "when": { "mcp_condition": "input_required" },
      "emit": "agent.input_requested"
    },
    {
      "id": "rule-approval-boundary",
      "status": "accepted",
      "when": { "mcp_condition": "approval_required" },
      "emit": "agent.approval_requested"
    },
    {
      "id": "rule-cms-unmeasured",
      "status": "accepted",
      "when": { "mcp_condition": "cms_unmeasured" },
      "emit": "agent.input_requested"
    },
    {
      "id": "rule-task-completed",
      "status": "accepted",
      "when": { "mcp_condition": "task_completed" },
      "emit": "agent.completed"
    },
    {
      "id": "rule-tool-failed",
      "status": "accepted",
      "when": { "mcp_condition": "tool_failed" },
      "emit": "agent.failed"
    },
    {
      "id": "rule-source-lost",
      "status": "accepted",
      "when": { "mcp_condition": "source_lost" },
      "emit": "agent.unobserved"
    },
    {
      "id": "rule-recovered",
      "status": "accepted",
      "when": { "mcp_condition": "trusted_after_failure" },
      "emit": "agent.recovered"
    },
    {
      "id": "rule-authority-denied",
      "status": "accepted",
      "when": { "mcp_condition": "authority_denied" },
      "emit": "agent.authority_denied"
    }
  ],
  "silent_conditions": [
    "tools_call_healthy",
    "progress",
    "resource_read",
    "initialize",
    "ping"
  ],
  "events": {
    "agent.unobserved": {
      "lifecycle_states": ["unobserved"],
      "channels": ["advisory"],
      "requires_action": false,
      "terminal_values": [false],
      "attention_reasons": ["source_unavailable", "source_expired"]
    },
    "agent.running": {
      "lifecycle_states": ["running"],
      "channels": ["nominal"],
      "requires_action": false,
      "terminal_values": [false],
      "attention_reasons": [null]
    },
    "agent.approval_requested": {
      "lifecycle_states": ["needs_input"],
      "channels": ["handoff"],
      "requires_action": true,
      "terminal_values": [false],
      "attention_reasons": ["approval_required"]
    },
    "agent.input_requested": {
      "lifecycle_states": ["needs_input"],
      "channels": ["handoff"],
      "requires_action": true,
      "terminal_values": [false],
      "attention_reasons": ["user_input_required", "cms_unmeasured"]
    },
    "agent.completed": {
      "lifecycle_states": ["complete"],
      "channels": ["nominal"],
      "requires_action": false,
      "terminal_values": [true],
      "attention_reasons": [null]
    },
    "agent.failed": {
      "lifecycle_states": ["error"],
      "channels": ["warning", "critical"],
      "requires_action": false,
      "terminal_values": [true],
      "attention_reasons": ["tool_failed", "turn_failed"]
    },
    "agent.recovered": {
      "lifecycle_states": ["idle", "running", "complete"],
      "channels": ["recovery"],
      "requires_action": false,
      "terminal_values": [false, true],
      "attention_reasons": ["cms_pass", null]
    },
    "agent.authority_denied": {
      "lifecycle_states": ["error"],
      "channels": ["warning", "critical"],
      "requires_action": false,
      "terminal_values": [true],
      "attention_reasons": ["authority_denied", "authority_revoked"]
    }
  }
}
