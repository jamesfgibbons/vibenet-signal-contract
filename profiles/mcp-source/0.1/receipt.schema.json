{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vibenet.ai/protocol/profiles/mcp-source/0.1/receipt.schema.json",
  "title": "VIBEnet MCP Source Mapping Receipt 0.1",
  "description": "Audit of one MCP observation through mcp-source/0.1. Does not rewrite Signal Contract v1.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "receipt_id",
    "mcp_spec_version",
    "profile",
    "source_method",
    "mcp_condition",
    "mapping_rule_id",
    "mapping_result",
    "signal_contract_id",
    "task_ref",
    "actor_ref",
    "content_redacted",
    "generated_at"
  ],
  "properties": {
    "schema_version": { "const": "vibenet.mcp-source-receipt/0.1" },
    "receipt_id": { "type": "string", "minLength": 1 },
    "mcp_spec_version": { "const": "2026-07-28" },
    "profile": { "const": "vibenet.mcp-source/0.1" },
    "source_method": { "type": "string", "minLength": 1 },
    "mcp_condition": { "type": "string", "minLength": 1 },
    "mapping_rule_id": { "type": ["string", "null"] },
    "mapping_result": {
      "enum": ["emitted", "unmapped", "ignored_class", "duplicate", "invalid_signal"]
    },
    "signal_contract_id": { "type": ["string", "null"] },
    "task_ref": {
      "type": "string",
      "pattern": "^(hmac-sha256:[a-f0-9]{64}|fixture:[a-z0-9._-]+)$"
    },
    "actor_ref": {
      "type": "string",
      "pattern": "^(hmac-sha256:[a-f0-9]{64}|fixture:[a-z0-9._-]+)$"
    },
    "content_redacted": { "const": true },
    "cms_verdict": {
      "type": ["string", "null"],
      "enum": ["UNMEASURED", "PASS", "FAIL", "N/A", null]
    },
    "generated_at": { "type": "string", "format": "date-time" }
  }
}
